# Copy to .env for local development. Generate secrets; do not use example values.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://dorsum_app:YOUR_PASSWORD@127.0.0.1:5432/dorsum
JWT_ACCESS_SECRET=GENERATE_A_UNIQUE_RANDOM_64_BYTE_SECRET
MEDIA_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_BASE64
APP_ORIGINS=http://localhost:5173
ALLOW_PUBLIC_REGISTRATION=true
# true only during import, before encrypt-media.mjs --apply
ALLOW_LEGACY_MEDIA=true
TZ=Europe/Kyiv

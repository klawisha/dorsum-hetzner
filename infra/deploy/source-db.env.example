# Copy to secrets/source-db.env with mode 600.
# Take the DIRECT external DB connection from the current Render DATABASE_URL,
# or from the database provider if the DB is hosted separately.
PGHOST=YOUR_SOURCE_DATABASE_HOST
PGPORT=5432
PGDATABASE=YOUR_SOURCE_DATABASE_NAME
PGUSER=YOUR_SOURCE_DATABASE_USER
PGPASSWORD=YOUR_SOURCE_DATABASE_PASSWORD
PGSSLMODE=verify-full
PGSSLROOTCERT=system
PGCONNECT_TIMEOUT=15
